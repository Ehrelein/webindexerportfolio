# WebIndexer Configuration
# Copy to .env and fill in values

# Environment
NODE_ENV=production

# Server
PORT=3000
HOST=0.0.0.0

# Database
DB_PATH=./crawler.db

# Crawler
CONCURRENCY=15
DOMAIN_LIMIT=15
DOMAIN_MAX=200
MAX_DEPTH=10
FETCH_TIMEOUT=3500
QUEUE_LOW_WATER=10000
SEED_BATCH=500
MIN_DISK_MB=500
DISK_MAX_USAGE_PCT=80

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Kafka
KAFKA_CLIENT_ID=webindexer-prod
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=urls

# Elasticsearch
ES_NODE=http://localhost:9200
ES_INDEX=pages

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_SEARCH_MAX=30

# Security
SESSION_SECRET=change-me-in-production

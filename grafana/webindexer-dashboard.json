{
  "dashboard": {
    "id": null,
    "uid": "webindexer",
    "title": "WebIndexer Crawler",
    "tags": ["webindexer", "crawler", "prometheus"],
    "timezone": "browser",
    "refresh": "5s",
    "time": { "from": "now-1h", "to": "now" },
    "panels": [
      {
        "title": "Indexed Nodes",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "targets": [{
          "expr": "webindexer_nodes_total",
          "legendFormat": "nodes"
        }],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 100000, "color": "blue" }, { "value": 500000, "color": "purple" }] }
          }
        }
      },
      {
        "title": "Frontier Size",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
        "targets": [{
          "expr": "webindexer_frontier_total",
          "legendFormat": "frontier"
        }],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 10000, "color": "yellow" }, { "value": 50000, "color": "red" }] }
          }
        }
      },
      {
        "title": "Domains Tracked",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
        "targets": [{
          "expr": "webindexer_domains_total",
          "legendFormat": "domains"
        }],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 500, "color": "blue" }, { "value": 1000, "color": "purple" }] }
          }
        }
      },
      {
        "title": "Uptime",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
        "targets": [{
          "expr": "webindexer_uptime_seconds",
          "legendFormat": "uptime"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": { "mode": "thresholds" },
            "thresholds": { "steps": [{ "value": 0, "color": "green" }] }
          }
        }
      },
      {
        "title": "Crawl Throughput (pg/s)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
        "targets": [{
          "expr": "webindexer_pages_per_second",
          "legendFormat": "pg/s"
        }],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": { "fillOpacity": 20, "lineWidth": 2 }
          }
        }
      },
      {
        "title": "Success vs Fail",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
        "targets": [
          { "expr": "webindexer_success_total", "legendFormat": "success" },
          { "expr": "webindexer_fail_total", "legendFormat": "fail" }
        ],
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "palette-classic" },
            "custom": { "fillOpacity": 10, "lineWidth": 2 }
          }
        }
      },
      {
        "title": "CPU Load",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
        "targets": [{
          "expr": "webindexer_cpu_load",
          "legendFormat": "load"
        }],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "color": { "mode": "palette-classic" },
            "custom": { "fillOpacity": 15, "lineWidth": 2 },
            "thresholds": { "steps": [{ "value": 0, "color": "green" }, { "value": 0.7, "color": "yellow" }, { "value": 0.9, "color": "red" }] }
          }
        }
      },
      {
        "title": "Memory Usage",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
        "targets": [
          { "expr": "webindexer_memory_rss_bytes", "legendFormat": "RSS" },
          { "expr": "webindexer_memory_heap_used_bytes", "legendFormat": "Heap" }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "bytes",
            "color": { "mode": "palette-classic" },
            "custom": { "fillOpacity": 10, "lineWidth": 2 }
          }
        }
      }
    ]
  },
  "overwrite": true
}

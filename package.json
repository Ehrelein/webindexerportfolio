{
  "name": "webindexerportfolio",
  "version": "1.0.0",
  "description": "Production web crawler with PostgreSQL, Kafka, Redis, Elasticsearch, K8s",
  "main": "server.ts",
  "scripts": {
    "build": "tsc",
    "start": "ts-node server.ts",
    "start:dev": "NODE_ENV=development ts-node-dev --respawn server.ts",
    "start:prod": "tsc && node dist/server.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --forceExit --detectOpenHandles",
    "test:integration": "jest --config tests/jest-integration.config.js --forceExit",
    "test:e2e": "jest --config tests/e2e/jest-e2e.config.js --forceExit --detectOpenHandles",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "migrate": "ts-node migrations/migrate.ts",
    "migrate:status": "ts-node migrations/migrate.ts --status",
    "lint": "ts-node scripts/lint.ts || true",
    "docker:up": "docker-compose -f docker-compose.prod.yaml up -d",
    "docker:down": "docker-compose -f docker-compose.prod.yaml down",
    "docker:logs": "docker-compose -f docker-compose.prod.yaml logs -f",
    "docker:build": "docker-compose -f docker-compose.prod.yaml build",
    "chaos": "ts-node load-test/chaos.ts",
    "chaos:all": "ts-node load-test/chaos.ts all",
    "backup": "bash scripts/backup.sh",
    "deploy": "ts-node vps.ts deploy",
    "status": "ts-node vps.ts status"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.17.0",
    "better-sqlite3": "11.7.0",
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^8.3.0",
    "ioredis": "^5.3.2",
    "kafkajs": "^2.2.4",
    "pg": "^8.22.0",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "ssh2": "^1.17.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.2"
  }
}
